# Browser-safe Supabase configuration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Local callback URL used by payment routes.
NEXT_APP_URL=http://localhost:3000

# Server-only secrets. Required only to exercise Paystack payment routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PAYSTACK_SECRET_KEY=your-paystack-test-secret-key

# Server-only SMS hook credentials.
WINSMS_API_KEY=
SUPABASE_SMS_HOOK_SECRET=
